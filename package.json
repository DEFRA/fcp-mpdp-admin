{
  "name": "fcp-mpdp-admin",
  "version": "0.0.0",
  "description": "CDP Frontend Template",
  "sideEffects": false,
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "build:frontend": "vite build",
    "dev": "vite build --mode development && npm-run-all2 --parallel frontend:watch server:watch",
    "dev:debug": "vite build --mode development && npm-run-all2 --parallel frontend:watch server:debug",
    "docker:build": "docker compose --profile app build",
    "docker:dev": "docker compose --profile app up",
    "frontend:watch": "vite build --mode development --watch",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "server:debug": "node --env-file-if-exists=.env --watch --watch-path=./src --watch-path=./.public/assets-manifest.json --inspect src/index.js",
    "server:watch": "node --env-file-if-exists=.env --watch --watch-path=./src --watch-path=./.public/assets-manifest.json src/index.js",
    "local": "npm run services:up && npm run dev",
    "services:up": "docker compose up -d",
    "services:down": "docker compose down",
    "start": "NODE_ENV=production node .",
    "test": "npm run build:frontend && cross-env TZ=UTC vitest run --coverage",
    "test:unit": "npm run build:frontend && cross-env TZ=UTC vitest run --coverage --project unit",
    "test:integration": "npm run build:frontend && cross-env TZ=UTC vitest run --coverage --project integration",
    "test:watch": "cross-env TZ=UTC vitest",
    "test:debug": "cross-env TZ=UTC vitest --inspect --no-file-parallelism"
  },
  "author": "Defra DDTS",
  "contributors": [
    "John Watson <john.watson1@defra.gov.uk>"
  ],
  "license": "OGL-UK-3.0",
  "dependencies": {
    "@aws-sdk/client-sts": "3.1160.0",
    "@defra/cdp-metrics": "0.6.1",
    "@defra/hapi-tracing": "1.30.1",
    "@elastic/ecs-pino-format": "1.5.0",
    "@hapi/bell": "13.2.1",
    "@hapi/catbox-memory": "6.0.2",
    "@hapi/catbox-redis": "7.1.0",
    "@hapi/cookie": "12.0.1",
    "@hapi/crumb": "9.0.1",
    "@hapi/hapi": "21.4.12",
    "@hapi/inert": "7.1.3",
    "@hapi/jwt": "3.2.4",
    "@hapi/scooter": "8.0.0",
    "@hapi/vision": "7.0.3",
    "@hapi/yar": "11.0.3",
    "blankie": "5.0.0",
    "convict": "6.2.5",
    "convict-format-with-validator": "6.2.0",
    "date-fns": "4.4.0",
    "global-agent": "3.0.0",
    "govuk-frontend": "6.6.0",
    "hapi-pino": "13.0.0",
    "hapi-pulse": "4.0.0",
    "ioredis": "5.11.1",
    "joi": "18.3.1",
    "node-fetch": "3.3.2",
    "nunjucks": "3.2.4",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0",
    "semver": "7.8.5",
    "undici": "7.30.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.12",
    "cheerio": "1.2.0",
    "cross-env": "7.0.3",
    "eslint": "9.39.5",
    "jsdom": "26.1.0",
    "neostandard": "0.12.1",
    "npm-run-all2": "7.0.2",
    "sass": "1.107.0",
    "stylelint": "16.26.1",
    "stylelint-config-gds": "2.0.0",
    "testcontainers": "12.2.1",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "vitest-fetch-mock": "0.4.5"
  },
  "overrides": {
    "hapi-pulse": {
      "joi": "18.3.1"
    }
  }
}
